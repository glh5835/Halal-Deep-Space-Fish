# ==============================
# 1. 你的项目专属配置 (保留)
# ==============================
.idea/
venv-ardupilot/

# ==============================
# 2. Python 标准忽略项 (建议添加)
# ==============================
# Python 编译产生的字节码文件
__pycache__/
*.py[cod]
*$py.class

# C 语言扩展编译文件 (如果你用到了 numpy 等底层库)
*.so
*.pyd
build/
dist/

# Jupyter Notebook 的缓存
.ipynb_checkpoints/

# 虚拟环境通用名称 (防止以后换个名字忘了加)
venv/
env/
.venv/

# 操作系统产生的垃圾文件
.DS_Store       # Mac
Thumbs.db       # Windows
desktop.ini     # Windows

# IDE 配置 (除了 PyCharm，还有 VS Code)
.vscode/        # VS Code 的配置文件夹
*.swp           # Vim 编辑器临时文件
*.swo

# 日志和数据库文件
*.log
*.sqlite3