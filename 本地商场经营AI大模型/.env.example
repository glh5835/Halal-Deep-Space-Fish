# 后端配置示例（复制为环境变量或写入 docker-compose environment 使用）
# SQLite 连接串；容器内挂载目录用 sqlite:////app/data/mall_sales.db（四个斜杠=绝对路径）
DATABASE_URL=sqlite:///./mall_sales.db
# Ollama 服务地址；Docker 容器内连宿主机用 http://host.docker.internal:11434
# 前提：宿主机 Ollama 需设置 OLLAMA_HOST=0.0.0.0 并放行防火墙 11434 端口
OLLAMA_BASE_URL=http://localhost:11434
# 推理模型；8GB 显存推荐 qwen2.5:7b（4.7GB），14B 需要 16GB 以上显存
OLLAMA_MODEL=qwen2.5:7b
# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=50
